# Kaggle API credentials -- https://www.kaggle.com/settings > API > Create New Token
# Newer accounts get a single opaque token starting with KGA -> KAGGLE_API_TOKEN.
# Older accounts download kaggle.json with a username/key pair -> use KAGGLE_KEY instead.
# Copy this file to .env and fill it in. .env is git-ignored -- never commit real keys.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=

# Optional: Hugging Face token, only needed for gated models (roberta-base is not gated)
# HF_TOKEN=

# Optional: redirect where runs write locally
# F2C_DATA_DIR=data
# F2C_RESULTS_DIR=results
# F2C_CHECKPOINT_DIR=checkpoints
